# ==============================================================================
# State-Driven Go Commentary Environment Configuration (.env.example)
# Copy this file to .env and adjust variables as needed:
#   cp .env.example .env
# ==============================================================================

# OpenAI-compatible API Endpoint (vLLM / llama.cpp / Ollama / OpenAI API)
API_URL=http://host.docker.internal:8000/v1/chat/completions

# API Key (Use 'EMPTY' for local vLLM / llama.cpp servers)
OPENAI_API_KEY=EMPTY

# Target Model Identifier (Optional, fallback if server dynamic detection fails)
MODEL_NAME=qwen3.2-27b
